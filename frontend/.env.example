# Copy this file to .env (same folder). Vite only exposes vars to client
# code when they're prefixed VITE_.

# Backend REST API base URL.
VITE_API_URL=http://localhost:5000/api

# Optional — only needed if the Socket.io server ever lives at a different
# origin than VITE_API_URL (minus the /api suffix). Usually leave unset.
# VITE_SOCKET_URL=http://localhost:5000

# Google sign-in — the OAuth 2.0 *Web* client ID from Google Cloud Console.
# Same value as GOOGLE_CLIENT_ID in the backend. Leave empty to hide the live
# Google button (the page shows a "not configured" note instead).
VITE_GOOGLE_CLIENT_ID=
